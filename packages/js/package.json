{
	"name": "@camaleaun/draw",
	"version": "0.1.0",
	"description": "A drawing as blocks: reads and writes block markup (wp:draw/*), in the browser or in Node.",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [ "dist" ],
	"scripts": {
		"build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js && tsc -p . --emitDeclarationOnly --outDir dist",
		"test": "npm run build && node --test tests/*.test.mjs"
	},
	"devDependencies": {
		"esbuild": "^0.25.0",
		"typescript": "^5.6.0"
	}
}
