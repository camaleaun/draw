{
	"fields": [ "name", "event", "location", "issued_date", "hours" ],
	"roundtrip": [
		{ "text": "Dear [[name]]", "runs": [ { "text": "Dear " }, { "field": "name" } ] },
		{ "text": "held in **[[location]]**, ok", "runs": [ { "text": "held in " }, { "field": "location", "b": true }, { "text": ", ok" } ] },
		{ "text": "*[[event]]* and **bold**", "runs": [ { "field": "event", "i": true }, { "text": " and " }, { "text": "bold", "b": true } ] },
		{ "text": "***both***", "runs": [ { "text": "both", "b": true, "i": true } ] },
		{ "text": "**Dear [[name]]**", "runs": [ { "text": "Dear ", "b": true }, { "field": "name", "b": true } ] },
		{ "text": "**a*b*c**", "runs": [ { "text": "a", "b": true }, { "text": "b", "b": true, "i": true }, { "text": "c", "b": true } ] },
		{ "text": "*a***b**", "runs": [ { "text": "a", "i": true }, { "text": "b", "b": true } ] },
		{ "text": "a*b*c", "runs": [ { "text": "a" }, { "text": "b", "i": true }, { "text": "c" } ] },
		{ "text": "[[name]][[event]]", "runs": [ { "field": "name" }, { "field": "event" } ] },
		{ "text": "a\nb", "runs": [ { "text": "a\nb" } ] },
		{ "text": "5 \\* 3", "runs": [ { "text": "5 * 3" } ] },
		{ "text": "\\[[name]]", "runs": [ { "text": "[[name]]" } ] },
		{ "text": "[name] stays [text]", "runs": [ { "text": "[name] stays [text]" } ] },
		{ "text": "a[[[name]]]", "runs": [ { "text": "a[" }, { "field": "name" }, { "text": "]" } ] },
		{ "text": "\\{name}", "runs": [ { "text": "{name}" } ] },
		{ "text": "snake_case and _x_", "runs": [ { "text": "snake_case and _x_" } ] },
		{ "text": "[[issued_date:long]]", "runs": [ { "field": "issued_date", "format": "long" } ] },
		{ "text": "Olá **mundo**", "runs": [ { "text": "Olá " }, { "text": "mundo", "b": true } ] },
		{ "text": "a\\\\b", "runs": [ { "text": "a\\b" } ] },
		{ "text": "", "runs": [] }
	],
	"parse": [
		{ "text": "5 * 3", "runs": [ { "text": "5 * 3" } ] },
		{ "text": "**a*", "runs": [ { "text": "**a*" } ] },
		{ "text": "*italic* text", "runs": [ { "text": "italic", "i": true }, { "text": " text" } ] },
		{ "text": "****x****", "runs": [ { "text": "****x****" } ] },
		{ "text": "{name} and {unknown}", "runs": [ { "field": "name" }, { "text": " and {unknown}" } ] },
		{ "text": "[unknown] and [[unknown]]", "runs": [ { "text": "[unknown] and [[unknown]]" } ] },
		{ "text": "[name] is text", "runs": [ { "text": "[name] is text" } ] },
		{ "text": "[[[name]]]", "runs": [ { "text": "[" }, { "field": "name" }, { "text": "]" } ] },
		{ "text": "\\[[name]]", "runs": [ { "text": "[[name]]" } ] },
		{ "text": "[[ name ]]", "runs": [ { "text": "[[ name ]]" } ] },
		{ "text": "[[name", "runs": [ { "text": "[[name" } ] },
		{ "text": "[[a:b:c]]", "runs": [ { "text": "[[a:b:c]]" } ] },
		{ "text": "[[name:site]]", "runs": [ { "field": "name" } ] },
		{ "text": "_not italic_", "runs": [ { "text": "_not italic_" } ] },
		{ "text": "\\_x", "runs": [ { "text": "_x" } ] },
		{ "text": "back\\slash", "runs": [ { "text": "back\\slash" } ] },
		{ "text": "*open", "runs": [ { "text": "*open" } ] },
		{ "text": "[[foo]]", "fields": null, "runs": [ { "field": "foo" } ] }
	]
}
